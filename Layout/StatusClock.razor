@implements IDisposable

<time>@now.ToString("HH:mm")</time>

@code
{
	private DateTime now = DateTime.Now;

	private Timer? timer;

	protected override void OnInitialized()
	{
		timer = new Timer(_ => InvokeAsync(() =>
		{
			now = DateTime.Now;
			StateHasChanged();
		}), null, 10_000, 10_000);
	}

	public void Dispose() => timer?.Dispose();
}
