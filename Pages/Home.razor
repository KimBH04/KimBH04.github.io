@page "/"

<PageTitle>KimBH04</PageTitle>

@{
	var visible = Filtered();
}

<header class="Heading">
	<h1>Posts</h1>
	<span class="Count">[@visible.Count.ToString("00")]</span>
</header>

<div class="Toolbar">
	<div class="Tabs" role="group" aria-label="카테고리">
		<button type="button" class="Tab" aria-pressed="@Pressed(null)" @onclick="() => category = null">
			ALL<span>@repo.SortedPostByTime.Count</span>
		</button>
		@foreach (var (name, count) in categories)
		{
			<button type="button" class="Tab" aria-pressed="@Pressed(name)" @onclick="() => category = name">
				@name<span>@count</span>
			</button>
		}
	</div>

	<label class="Search">
		<span class="Prompt" aria-hidden="true">&gt;</span>
		<input type="search" placeholder="제목 검색" aria-label="제목 검색" @bind="query" @bind:event="oninput" />
	</label>
</div>

@if (visible.Count == 0)
{
	<p class="Empty">조건에 맞는 글이 없습니다.</p>
}
else
{
	<div class="List">
		<div class="ListHead" aria-hidden="true">
			<span class="No">No.</span>
			<span class="Title">Title</span>
			<span class="Tags">Tags</span>
			<span class="Date">Date</span>
		</div>
		<ol>
			@foreach (var post in visible)
			{
				<li>
					<a class="Row" href="/post/@post.Slug">
						<span class="No">@numbers[post.Slug].ToString("00")</span>
						<span class="Title">@post.Title</span>
						<span class="Tags">
							@foreach (var tag in post.Categories.ToArray())
							{
								<span class="tag">@tag</span>
							}
						</span>
						@if (post.Time == DateTime.MinValue)
						{
							<span class="Date">—</span>
						}
						else
						{
							<time class="Date" datetime="@post.Time.ToString("yyyy-MM-dd")">@post.Time.ToString("yyyy.MM.dd")</time>
						}
					</a>
				</li>
			}
		</ol>
	</div>
}

@code
{
	private string? category;

	private string query = string.Empty;

	private (string Name, int Count)[] categories = [];

	private readonly Dictionary<string, int> numbers = [];

	protected override void OnInitialized()
	{
		var posts = repo.SortedPostByTime;

		for (int i = 0; i < posts.Count; i++)
		{
			numbers[posts[i].Slug] = posts.Count - i;
		}

		categories = posts
			.SelectMany(p => p.Categories.ToArray())
			.GroupBy(c => c)
			.Select(g => (g.Key, g.Count()))
			.OrderByDescending(c => c.Item2)
			.ThenBy(c => c.Key)
			.ToArray();
	}

	private List<PostInfo> Filtered()
	{
		var q = query.Trim();

		return repo.SortedPostByTime
			.Where(p => category is null || p.Categories.Span.Contains(category))
			.Where(p => q.Length == 0 || p.Title.Contains(q, StringComparison.OrdinalIgnoreCase))
			.ToList();
	}

	private string Pressed(string? name) => name == category ? "true" : "false";
}
